{
    // Args mirror the runs actually in flight (see the session's L*/W_warm arms), so a
    // debug session is the real run. Additions are debugger necessities only:
    //   --compile        (no values) turns OFF torch.compile, which otherwise defaults to
    //                    ["frontend","transformer_blocks","task_heads"] and traces away
    //                    every breakpoint inside the model.
    //   --num-workers 0  keeps the dataloader in-process so breakpoints there hit.
    //   --name debug_*   so debug checkpoints do not collide with real runs.
    //
    // N is derived, not passed: train.py resolves the candidate count from
    // --train_length and --bpm_max, so there is no stage or candidate flag to set here.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "train: subset baseline (L1_base)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/launch_scripts/train.py",
            "cwd": "${workspaceFolder}",
            "env": {"PYTHONPATH": "${workspaceFolder}",
                    "OMP_NUM_THREADS": "2", "MKL_NUM_THREADS": "2", "OPENBLAS_NUM_THREADS": "2"},
            "args": [
                "--name", "debug_L1_base", "--gpu", "0", "--fold", "0", "--seed", "0",
                "--max-epochs", "100", "--val-frequency", "200", "--snapshot_every", "5",
                "--head_type", "subset",
                "--num-workers", "0", "--logger", "none", "--compile"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "train: subset + candidate attention (L2_attn)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/launch_scripts/train.py",
            "cwd": "${workspaceFolder}",
            "env": {"PYTHONPATH": "${workspaceFolder}",
                    "OMP_NUM_THREADS": "2", "MKL_NUM_THREADS": "2", "OPENBLAS_NUM_THREADS": "2"},
            "args": [
                "--name", "debug_L2_attn", "--gpu", "2", "--fold", "0", "--seed", "0",
                "--max-epochs", "100", "--val-frequency", "200", "--snapshot_every", "5",
                "--head_type", "subset",
                // section 10.2: candidate self-attention in the class branch, so the
                // candidates can coordinate instead of each deciding blind.
                "--attention_layers", "1",
                "--num-workers", "0", "--logger", "none", "--compile"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "train: subset, latent meter + corpus meter prior",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/launch_scripts/train.py",
            "cwd": "${workspaceFolder}",
            "env": {"PYTHONPATH": "${workspaceFolder}",
                    "OMP_NUM_THREADS": "2", "MKL_NUM_THREADS": "2", "OPENBLAS_NUM_THREADS": "2"},
            "args": [
                "--name", "debug_meter", "--gpu", "3", "--fold", "0", "--seed", "0",
                "--max-epochs", "20", "--val-frequency", "200", "--snapshot_every", "5",
                "--head_type", "subset",
                // only affects beat-only fragments (smc, simac): infers L per fragment
                "--meter_candidates", "2,3,4,6",
                "--num-workers", "0", "--logger", "none", "--compile"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "train: subset, warm-start the encoder (W_warm)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/launch_scripts/train.py",
            "cwd": "${workspaceFolder}",
            "env": {"PYTHONPATH": "${workspaceFolder}",
                    "OMP_NUM_THREADS": "2", "MKL_NUM_THREADS": "2", "OPENBLAS_NUM_THREADS": "2"},
            "args": [
                "--name", "debug_warm", "--gpu", "0", "--fold", "0", "--seed", "0",
                "--max-epochs", "20", "--val-frequency", "200", "--snapshot_every", "5",
                "--head_type", "subset",
                // frontend + transformer only; the head is always freshly initialised
                "--init_encoder_from", "${workspaceFolder}/checkpoints/final100_subset S0 fold0 shift_tolerant_weighted_bce-h512-augTrueTrueTrue-epepoch=069.ckpt",
                "--num-workers", "0", "--logger", "none", "--compile"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "train: dense control (vanilla Beat This)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/launch_scripts/train.py",
            "cwd": "${workspaceFolder}",
            "env": {"PYTHONPATH": "${workspaceFolder}",
                    "OMP_NUM_THREADS": "2", "MKL_NUM_THREADS": "2", "OPENBLAS_NUM_THREADS": "2"},
            "args": [
                "--name", "debug_dense", "--gpu", "0", "--fold", "0", "--seed", "0",
                "--max-epochs", "100", "--val-frequency", "200", "--snapshot_every", "5",
                "--head_type", "dense",
                "--num-workers", "0", "--logger", "none", "--compile"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "score: our snapshots on fold 0 (beat + downbeat)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/launch_scripts/score_fold0_subset.py",
            "cwd": "${workspaceFolder}",
            "env": {"PYTHONPATH": "${workspaceFolder}"},
            "args": [
                "--gpu", "0", "--fold", "0", "--num-workers", "0",
                "--pattern", "checkpoints/L1_base*.ckpt",
                "--out", "cache/fold0_subset_scores.csv"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "score: vanilla snapshots on fold 0 (beat + downbeat)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/launch_scripts/score_fold0_dense.py",
            "cwd": "${workspaceFolder}",
            "env": {"PYTHONPATH": "${workspaceFolder}"},
            "args": [
                "--gpu", "0", "--fold", "0", "--num-workers", "0",
                "--pattern", "/disk1/jaehoon/ckpt_snapshots/vanillaS1_f0_ep099.ckpt",
                "--out", "cache/fold0_dense_scores.csv"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "diagnose_bottleneck (A/B/C/D + downbeat precision)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/diagnose_bottleneck.py",
            "cwd": "${workspaceFolder}",
            "env": {"PYTHONPATH": "${workspaceFolder}"},
            "args": [
                "--checkpoints", "checkpoints/T_aligned*epoch=079.ckpt",
                "--songs", "100", "--gpu", "0", "--num-workers", "0"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            // Stepping through the decoder itself: loads one cached piece, no GPU and no
            // Lightning, so a breakpoint in _elapsed_beats or _viterbi hits in a second.
            // Edit PIECE in the script to pick a different one.
            "name": "debug: decode_piece on one cached piece",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/launch_scripts/debug_decode_piece.py",
            "cwd": "${workspaceFolder}",
            "env": {"PYTHONPATH": "${workspaceFolder}"},
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            // The whole inference path on fold 0: stitching, the fragment seams, and
            // subset_predict_piece. --read-out is the only way to reach anything but
            // per_event, since no checkpoint records the setting.
            "name": "score: fold 0, duration-conditioned decoding",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/launch_scripts/compute_paper_metrics.py",
            "cwd": "${workspaceFolder}",
            "env": {"PYTHONPATH": "${workspaceFolder}"},
            "args": [
                "--models", "/tmp/ours_ckpt/R_f0.ckpt",
                "--datasplit", "val", "--aggregation-type", "k-fold",
                "--read-out", "duration",
                "--gpu", "0", "--num_workers", "0"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "env": {"PYTHONPATH": "${workspaceFolder}"},
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
